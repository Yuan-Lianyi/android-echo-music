<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_main"
    app:startDestination="@id/homeFragment">

    <!-- 任意页面点击歌曲后跳播放页 -->
    <action
        android:id="@+id/action_global_player"
        app:destination="@id/playerFragment" />

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.android_echo_music.ui.home.HomeFragment"
        android:label="@string/nav_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/libraryFragment"
        android:name="com.example.android_echo_music.ui.library.SongListFragment"
        android:label="@string/nav_library"
        tools:layout="@layout/fragment_song_list" />

    <fragment
        android:id="@+id/playlistFragment"
        android:name="com.example.android_echo_music.ui.playlist.PlaylistListFragment"
        android:label="@string/nav_playlist"
        tools:layout="@layout/fragment_playlist" />

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.android_echo_music.ui.search.SearchFragment"
        android:label="@string/nav_search"
        tools:layout="@layout/fragment_search" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.android_echo_music.ui.settings.SettingsFragment"
        android:label="@string/nav_settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/playerFragment"
        android:name="com.example.android_echo_music.ui.player.PlayerFragment"
        android:label="@string/now_playing"
        tools:layout="@layout/fragment_player" />

</navigation>